# Copy to .env (gitignored). Values here are PATHS to secret files, never the secrets themselves.
# Secret files live only under ~/hackathons-2026/concordium/.secrets/ (chmod 600).
CONCORDIUM_NETWORK=testnet
CONCORDIUM_GRPC_HOST=grpc.testnet.concordium.com
CONCORDIUM_GRPC_PORT=20000
MCP_URL=https://agent-registry-mcp.concordium.com/mcp
INDEXER_URL=https://agent-registry-indexer.concordium.com
HUMAN_WALLET_FILE=../.secrets/human.testnet.export.json
SPONSOR_WALLET_FILE=../.secrets/sponsor.testnet.export.json
AGENT_KEY_FILE=../.secrets/agent.ed25519.testnet.json
# LLM mode only: ANTHROPIC_API_KEY is read from the process environment (loaded from ~/hackathons-2026/.secrets.env); never written here.
