# All optional. Defaults shown. Copy to .env (gitignored) only if you change something.
# Secret files (seed phrases, identity objects, agent key) live OUTSIDE the repo; this points at the directory, never at values.
MANDATE_SECRETS_DIR=../.secrets
# Non-secret runtime state (issued mandates, audit records, logs, evidence JSON).
MANDATE_STATE_DIR=../.state
MANDATE_MCP_URL=https://agent-registry-mcp.concordium.com
MANDATE_MCP_TIMEOUT_MS=4000
MANDATE_SPONSOR_URL=http://127.0.0.1:4022
MANDATE_RECORD_BASE=http://127.0.0.1:4022/proofs
FACILITATOR_PORT=4022
SITE_PORT=4021
SITE_ORIGIN=http://localhost:4021
REVOCATION_BOUND_MS=10000
# LLM agent mode (Gate 2) reads ANTHROPIC_API_KEY from the process environment only.
